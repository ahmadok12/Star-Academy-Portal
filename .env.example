# Supabase Configuration
# Replace with your actual Supabase project URL and anon public key
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# When set to true (or when Supabase URL is placeholder), the app operates in an instant local state mode
# loaded with the development seed data so you can test all workflows immediately out-of-the-box!
VITE_ENABLE_DEMO_MODE=true
